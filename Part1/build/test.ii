int sum(int nums[],int n){
    int ans=0;
    for(int i=0;i<n;i++){
        ans+=nums[i];
    }
    return ans;
}

inline int f(int num,int n){
    num = num % 1007;
    num = num ^ n;
    return num;
}

int main(){
    int nums[10];
    nums[0]=1;
    nums[1]=1;
    for(int i=3;i<10;i++){
        nums[i]=nums[i-1]+nums[i-2];
    }
    int s = 0;
    s+=sum(nums,10);
    s=f(s,10);
}
