// SysY reference program: arithmetic, arrays, control flow, function calls and I/O.
int calc(int a[], int n) {
    int i = 0;
    int ans = 0;

    while (i < n) {
        if (a[i] % 2 == 0) {
            ans = ans + (a[i] / 2) * 4;
        } else {
            ans = ans - a[i];
        }
        i = i + 1;
    }

    return ans;
}

int main() {
    int a[5] = {1, 2, 3, 4, 5};
    int n = getint();

    if (n < 0) {
        n = 0;
    }
    if (n > 5) {
        n = 5;
    }

    int ans = calc(a, n);
    putint(ans);
    putch(10);
    return 0;
}
